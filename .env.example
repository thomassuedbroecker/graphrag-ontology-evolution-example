# Local demo settings. Endpoints must stay on loopback.
# Demo-only password: Neo4j listens on 127.0.0.1 only. It is applied when the volume is first created.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=local-graphrag-demo
NEO4J_DATABASE=neo4j
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
MCP_URL=http://127.0.0.1:8000/mcp
LANGSMITH_TRACING=false
ANONYMIZED_TELEMETRY=false
# Seconds before ./scripts/ask.sh gives up waiting for the model.
ANSWER_TIMEOUT_SECONDS=300
